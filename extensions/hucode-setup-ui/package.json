{
  "name": "hucode-setup-ui",
  "displayName": "Hucode Setup UI",
  "description": "Renderer assets for Hucode's setup and import experience.",
  "version": "1.0.0",
  "publisher": "hucode",
  "license": "MIT",
  "private": true,
  "engines": {
    "vscode": "^1.70.0"
  },
  "categories": [
    "Other"
  ],
  "capabilities": {
    "virtualWorkspaces": false,
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "scripts": {
    "compile": "node ./esbuild.setup.mts",
    "watch": "node ./esbuild.setup.mts --watch",
    "typecheck": "node ../../node_modules/@typescript/native/lib/tsc.js --project ./src/tsconfig.json --noEmit",
    "test": "node ./esbuild.setup.mts && vitest run",
    "verify-vendor": "node ./scripts/verify-vendor.mts"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jimeh/hucode.git"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-virtual": "^3.14.10",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jsdom": "^26.1.0",
    "lucide-react": "^1.39.0",
    "postcss": "^8.5.26",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vitest": "^3.2.7"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
